{
  "name": "acuity-compass",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "api": "node --env-file=.env backend/src/server.ts",
    "db:migrate": "node --env-file=.env backend/src/cli.ts migrate",
    "db:import": "node --env-file=.env backend/src/cli.ts import",
    "check:backend": "tsc -p backend/tsconfig.json",
    "test:backend": "node --env-file=.env --test backend/tests/*.test.ts"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
