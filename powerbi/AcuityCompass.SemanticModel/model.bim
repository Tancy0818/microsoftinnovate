            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"127.0.0.1:5433\", \"acuitycompass\", [CreateNavigationProperties=false]),",
                "    Patients = Source{[Schema=\"reporting\",Item=\"interactive_patients\"]}[Data]",
                "in",
