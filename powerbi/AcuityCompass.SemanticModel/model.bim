                "    Typed = Table.TransformColumnTypes(Source, {{\"snapshot_time\", type datetime}, {\"report_date\", type date}, {\"area_id\", type text}, {\"occupied\", Int64.Type}, {\"staffed_capacity\", Int64.Type}, {\"is_bed_area\", Int64.Type}})",
