        "lineageTag": "c4c50753-6722-4013-b0f2-9d219f3e0136",
        "measures": [
          {
            "name": "Total arrivals",
            "displayFolder": "Dashboard metrics",
            "expression": "SUM(department_hourly[arrivals])",
            "formatString": "#,0",
            "lineageTag": "4989ca38-7240-46e8-a24d-c89da828a201"
          },
          {
            "name": "Total departures",
            "displayFolder": "Dashboard metrics",
            "expression": "SUM(department_hourly[departures])",
            "formatString": "#,0",
            "lineageTag": "125a04a9-3b6d-4042-90b7-cb5e3853a373"
          },
          {
            "name": "Latest snapshot",
            "displayFolder": "Dashboard metrics",
            "expression": "MAX(department_hourly[snapshot_time])",
            "formatString": "dd MMM yyyy HH:mm",
            "lineageTag": "e4bdbf1b-96a5-4147-b7b5-32ce6463ec67"
          },
          {
            "name": "Active patients",
            "displayFolder": "Dashboard metrics",
            "expression": "VAR S = [Latest snapshot] RETURN IF(ISBLANK(S), BLANK(), CALCULATE(MAX(department_hourly[active_patients]), department_hourly[snapshot_time] = S))",
            "formatString": "#,0",
            "lineageTag": "a423a7ba-42eb-4c30-b8f2-1b652f5ba9ef"
          },
          {
            "name": "Patients waiting",
            "displayFolder": "Dashboard metrics",
            "expression": "VAR S = [Latest snapshot] RETURN IF(ISBLANK(S), BLANK(), CALCULATE(MAX(department_hourly[patients_waiting]), department_hourly[snapshot_time] = S))",
            "formatString": "#,0",
            "lineageTag": "56d6b722-3a68-4830-94e5-bd5ace163f87"
          },
          {
            "name": "Bed occupancy",
            "displayFolder": "Dashboard metrics",
            "expression": "VAR S = [Latest snapshot] VAR O = CALCULATE(MAX(department_hourly[occupied_beds]), department_hourly[snapshot_time] = S) VAR C = CALCULATE(MAX(department_hourly[staffed_beds]), department_hourly[snapshot_time] = S) RETURN IF(ISBLANK(S), BLANK(), DIVIDE(O,C))",
            "formatString": "0.00%",
            "lineageTag": "83d4c5fc-7fe8-400c-9fce-1ab773fde483"
          },
          {
            "name": "Area bed occupancy",
            "displayFolder": "Dashboard metrics",
            "expression": "VAR S = [Latest snapshot] VAR O = CALCULATE(SUM(area_capacity_hourly[occupied]), area_capacity_hourly[snapshot_time] = S, area_capacity_hourly[is_bed_area] = 1) VAR C = CALCULATE(SUM(area_capacity_hourly[staffed_capacity]), area_capacity_hourly[snapshot_time] = S, area_capacity_hourly[is_bed_area] = 1) RETURN IF(ISBLANK(S), BLANK(), DIVIDE(O,C))",
            "formatString": "0.0%",
            "lineageTag": "e8d45aa6-bc80-4cb8-af65-53ce33385368"
          },
          {
            "name": "Visit count",
            "displayFolder": "Dashboard metrics",
            "expression": "COUNTROWS(visits)",
            "formatString": "#,0",
            "lineageTag": "4430d743-c33d-423d-8081-503befbb171f"
          },
          {
            "name": "Current queue average wait",
            "displayFolder": "Dashboard metrics",
            "expression": "VAR S = [Latest snapshot] RETURN IF(ISBLANK(S), BLANK(), CALCULATE(MAX(department_hourly[average_elapsed_wait_minutes]), department_hourly[snapshot_time] = S))",
            "formatString": "0.0 \"min\"",
            "lineageTag": "014c1a1f-08f3-4c57-8cbf-eb971ccac564"
          },
          {
            "name": "Average wait to assessment",
            "displayFolder": "Dashboard metrics",
            "expression": "AVERAGE(visits[wait_to_assessment_minutes])",
            "formatString": "0.0 \"min\"",
            "lineageTag": "fb871b15-8623-4221-8b42-09975590d0f1"
          },
          {
            "name": "Snapshot label",
            "displayFolder": "Dashboard metrics",
            "expression": "IF(ISBLANK([Latest snapshot]), \"No records loaded\", \"Snapshot: \" & FORMAT([Latest snapshot], \"dd MMM yyyy HH:mm\") & \" IST | Historical synthetic data\")",
            "lineageTag": "a2be69a4-47d8-42c7-9fdd-a11fd0d02a19"
          }
        ],
        "partitions": [
          {
            "name": "department_hourly",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"127.0.0.1:5433\", \"acuitycompass\", [Query=\"SELECT hour_start AT TIME ZONE 'Asia/Kolkata' AS hour_start, snapshot_time AT TIME ZONE 'Asia/Kolkata' AS snapshot_time, report_date, arrivals, departures, active_patients, patients_waiting, average_elapsed_wait_minutes, occupied_beds, staffed_beds FROM reporting.department_hourly\", CreateNavigationProperties=false]),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"hour_start\", type datetime}, {\"snapshot_time\", type datetime}, {\"report_date\", type date}, {\"arrivals\", Int64.Type}, {\"departures\", Int64.Type}, {\"active_patients\", Int64.Type}, {\"patients_waiting\", Int64.Type}, {\"average_elapsed_wait_minutes\", type number}, {\"occupied_beds\", Int64.Type}, {\"staffed_beds\", Int64.Type}})",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
