        "lineageTag": "1aca6256-572e-4c4d-8301-0a4c0a58726a",
        "measures": [
          {
            "name": "Entered visits",
            "expression": "COUNTA(interactive_patients[visit_id])",
            "formatString": "#,0",
            "lineageTag": "320168a2-8c65-48ba-bb9b-b1cf5d387bae"
          },
          {
            "name": "Current active",
            "expression": "SUM(interactive_patients[active_count])",
            "formatString": "#,0",
            "lineageTag": "6ce7cb91-fd1a-44a4-90bc-f4f6c0ad90b5"
          },
          {
            "name": "Current waiting",
            "expression": "SUM(interactive_patients[waiting_count])",
            "formatString": "#,0",
            "lineageTag": "11d222a0-8b33-44e8-acce-bb100d5b235f"
          },
          {
            "name": "Current occupancy",
            "expression": "DIVIDE(SUM(interactive_patients[occupied_count]), MAX(interactive_patients[staffed_beds]), 0)",
            "formatString": "0.00%",
            "lineageTag": "d0bb54f5-df4b-443c-a392-d6d4895d4a7c"
          },
          {
            "name": "Completed departures",
            "expression": "SUM(interactive_patients[departed_count])",
            "formatString": "#,0",
            "lineageTag": "4b50392a-7c61-4def-9418-2029edc11148"
          },
          {
            "name": "Refresh label",
            "expression": "\"Refreshed: \" & FORMAT(MAX(interactive_patients[refreshed_at]), \"dd MMM yyyy HH:mm\") & \" IST | Home > Refresh after website changes\"",
            "lineageTag": "93e69c9a-429a-4959-8a3d-e81d3318ce86"
          }
        ],
        "partitions": [
          {
